{
	"extends": "expo/tsconfig.base",
	"compilerOptions": {
		"strict": true,
		"paths": {
			"@Pages/*": ["./src/pages/*"],
			"@Components/*": ["./src/components/*"],
			"@Assets/*": ["./assets/*"],
			"@Icons/*": ["./assets/icons/*"]
		},
		"typeRoots": ["node_modules/@types", "src/types"]
	},
	"include": [
		"App.tsx",
		"app.d.ts",
		"src/**/*.ts",
		"src/**/*.tsx",
		"nativewind-env.d.ts"
	]
}
