{
	"name": "reactnative-starter",
	"version": "2.0.0",
	"main": "node_modules/expo/AppEntry.js",
	"scripts": {
		"start": "expo start",
		"android": "expo start --android",
		"ios": "expo start --ios",
		"web": "expo start --web",
		"prettier:base": "prettier --ignore-path .gitignore",
		"eslint:base": "eslint",
		"lint:eslint": "pnpm eslint:base --max-warnings 0 \"**/*.{js,ts,tsx,mdx}\"",
		"lint": "pnpm lint:eslint",
		"format:prettier": "pnpm prettier:base --write \"**/*.{js,ts,tsx,json,md,mdx}\"",
		"format:eslint": "pnpm eslint:base --fix \"**/*.{js,ts,tsx,mdx}\"",
		"format": "pnpm format:eslint && pnpm format:prettier",
		"prepare": "husky"
	},
	"dependencies": {
		"expo": "~57.0.24",
		"expo-status-bar": "~57.0.1",
		"nativewind": "^4.2.7",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"react-native": "0.86.3",
		"react-native-css-interop": "^0.2.7",
		"react-native-web": "~0.21.2"
	},
	"devDependencies": {
		"@babel/core": "^7.25.0",
		"@types/react": "~19.2.18",
		"babel-plugin-module-resolver": "^5.0.3",
		"babel-preset-expo": "^57.0.12",
		"eslint": "^9.39.5",
		"eslint-config-expo": "^57.0.2",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"husky": "^9.1.7",
		"postcss": "^8.5.28",
		"prettier": "^3.9.7",
		"tailwindcss": "^3.4.17",
		"typescript": "^6.0.3"
	},
	"private": true
}
